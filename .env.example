# Окружение проекта erp_lite. Скопировать в .env (в git не попадает).

# Порт приложения (то, что открывает пользователь). Диапазон 4100-4199.
APP_PORT=4110

# Порт backend API (FastAPI). Только loopback.
API_PORT=4111

# PostgreSQL проекта. Диапазон 5544-5559, свой контейнер и свой том.
POSTGRES_USER=erp_lite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp_lite
POSTGRES_PORT=5547

DATABASE_URL=postgresql+psycopg://erp_lite:change-me@127.0.0.1:5547/erp_lite
TEST_DATABASE_URL=postgresql+psycopg://erp_lite:change-me@127.0.0.1:5547/erp_lite_test
